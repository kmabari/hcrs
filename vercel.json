{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "distLogin"
        }
      ],
      "destination": "/api/district-page"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!assets/|.*\\..*|api/).*)",
      "destination": "/index.html"
    }
  ]
}
